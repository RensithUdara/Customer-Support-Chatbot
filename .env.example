# Copy this file to `.env.local` and fill in your real keys. Do NOT commit `.env.local`.
# Example: copy .env.example .env.local

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3

# Groq (optional)
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192

# Which provider to use by default (openai | anthropic | groq)
LLM_PROVIDER=openai

# Enable real LLM calls (set to 'true' to allow using the provider keys above)
ENABLE_REAL_LLM=false
